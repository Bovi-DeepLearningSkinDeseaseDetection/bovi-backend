# Copia este archivo como .env y ajusta los valores. Nunca subas el .env al repositorio.

# local | test | production
APP_ENV=local
LOG_LEVEL=INFO
# Muestra /docs y /redoc. Desactívalo en producción si no se necesita.
DOCS_ENABLED=true

# --- PostgreSQL ---
# En local apunta al contenedor "db" de docker-compose.yml.
# En AWS: postgresql+psycopg://<usuario>:<clave>@<endpoint-rds>:5432/bovi?sslmode=require
DATABASE_URL=postgresql+psycopg://bovi:bovi@localhost:5432/bovi
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# --- JWT ---
# En producción debe tener al menos 32 caracteres. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-este-secreto-solo-para-desarrollo-local
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=bovi-api

# --- Cuenta del ganadero ---
# Costo de bcrypt (mínimo 12 en producción).
BCRYPT_ROUNDS=12
# Versión del texto de consentimiento de datos que muestra la app (Ley N.° 29733).
CONSENT_VERSION=2026.1

# --- S3 (en local, un emulador compatible con S3 que se agrega en B2) ---
S3_BUCKET=bovi-evaluaciones
S3_REGION=sa-east-1
# Solo en local (emulador de S3). En AWS se deja vacío y las credenciales vienen del rol IAM de la EC2.
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_UPLOAD_URL_TTL_SECONDS=900
S3_DOWNLOAD_URL_TTL_SECONDS=900
S3_MAX_IMAGE_BYTES=512000

# --- Servidor (contenedor) ---
WEB_CONCURRENCY=2
